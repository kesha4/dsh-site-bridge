{
  "name": "dsh-site-bridge",
  "version": "0.5.0",
  "description": "Chrome/Edge MV3 bridge for DeepSeek Harness: capture page markup (DOM, styles, selectors) and BFF traffic (xhr/fetch with headers and bodies) into a workspace snapshot bundle, drive the page with trusted CDP input, and verify injected scripts. Authorization never leaves the browser and is never written to disk.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "extension",
    "docs",
    "scripts",
    "tools",
    "cordis.patch.yml"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "browser",
    "chrome-extension",
    "cdp",
    "dom",
    "network-capture"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node test/redact.test.mjs && node test/bridge.test.mjs && node test/artifacts.test.mjs && node test/plugin.test.mjs && node test/version.test.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:tools": "node test/tools-chrome.mjs",
    "test:multitab": "node test/multitab.mjs",
    "icons": "node tools/make-icons.mjs",
    "version:check": "node tools/version.mjs check",
    "version:bump": "node tools/version.mjs bump",
    "stage": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1 -StageOnly",
    "test:picker": "node test/picker.mjs",
    "test:ops": "node test/browser-ops.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kesha4/dsh-site-bridge.git"
  },
  "homepage": "https://github.com/kesha4/dsh-site-bridge#readme",
  "bugs": {
    "url": "https://github.com/kesha4/dsh-site-bridge/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0 || >=0.3.0-rc.1"
  }
}
