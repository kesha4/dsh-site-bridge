  "tabConnected": { "message": "Tab connected" },

  "connectionTitle": { "message": "Pairing" },
  "importBridge": { "message": "Import bridge.json" },
  "portLabel": { "message": "Bridge port" },
  "tokenLabel": { "message": "Token" },
